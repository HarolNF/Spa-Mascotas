<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar contraseña — Pet Spa Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #fff1f3 0%, #fce4ec 100%);
        }

        .btn-spa {
            background-color: #f50057;
            color: white;
            border-radius: 50px;
            border: none;
            transition: 0.3s;
        }

        .btn-spa:hover {
            background-color: #d4004b;
            color: white;
        }

        .login-card {
            border: none;
            border-radius: 1.5rem;
            box-shadow: 0 20px 60px rgba(245, 0, 87, 0.12);
        }

        a { color: #f50057; }
    </style>
</head>

<body class="d-flex align-items-center vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-8 col-md-6 col-lg-4">
                <div class="card login-card">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold" style="color:#f50057;">Recuperar contraseña</h2>
                            <p class="text-muted small">
                                Ingresa tu correo y te enviaremos las instrucciones para restablecer tu contraseña.
                            </p>
                        </div>

                        <% if (error) { %>
                            <div class="alert alert-danger text-center py-2"><%= error %></div>
                        <% } %>

                        <form action="/recuperar-password" method="post">
                            <div class="form-floating mb-3">
                                <input type="email"
                                       class="form-control border-0 bg-light shadow-sm"
                                       id="email"
                                       name="email"
                                       placeholder="name@example.com"
                                       required>
                                <label class="text-secondary">Correo electrónico</label>
                            </div>

                            <button type="submit" class="btn btn-spa w-100 py-3 fw-bold">
                                ENVIAR INSTRUCCIONES
                            </button>

                            <div class="text-center mt-4">
                                <a href="/login" class="text-decoration-none small fw-medium">
                                    ← Volver al login
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
