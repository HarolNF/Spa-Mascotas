<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title><%= pageTitle %> — Pet Spa Admin</title>

    <!-- Bootstrap 5 (lo usan las vistas de usuarios, roles y alertas) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Tailwind CSS (utilidades con prefijo tw- para no chocar con Bootstrap) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            prefix: 'tw-',
            corePlugins: { preflight: false },
            theme: {
                extend: {
                    colors: {
                        spa:  '#f50057',
                        spaDark: '#d4004b',
                        verde: '#639922',
                        verdeDark: '#3b6d11'
                    }
                }
            }
        };
    </script>
    <!-- Estilos propios del panel (tienen la última palabra) -->
    <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<div class="layout">

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <nav class="sidebar">
        <div class="brand">
            <img src="/img/logo03.png" alt="Logo" style="height: 40px; margin-right: 10px;" />
            <div>
                <div class="brand-title">Pet Spa Admin</div>
                <div class="brand-sub">Panel de gestión</div>
            </div>
        </div>

        <a href="/" class="nav-item<%= activePage === 'dashboard' ? ' active' : '' %>">📊 Dashboard</a>

        <% if (tienePermiso('VER_MASCOTAS')) { %>
            <a href="/mascotas" class="nav-item<%= activePage === 'mascotas' ? ' active' : '' %>">🐕 Mascotas</a>
        <% } %>

        <% if (tienePermiso('VER_CITAS')) { %>
            <a href="/citas" class="nav-item<%= activePage === 'citas' ? ' active' : '' %>">📅 Citas</a>
        <% } %>

        <% if (tienePermiso('VER_SERVICIOS')) { %>
            <a href="/servicios" class="nav-item<%= activePage === 'servicios' ? ' active' : '' %>">✂️ Servicios</a>
        <% } %>

        <% if (tienePermiso('VER_CLIENTES')) { %>
            <a href="/clientes" class="nav-item<%= activePage === 'clientes' ? ' active' : '' %>">👥 Clientes</a>
        <% } %>

        <hr class="nav-divider"/>

        <% if (tienePermiso('GESTIONAR_CITAS')) { %>
            <a href="/citas/nueva" class="nav-item nav-item--highlight">➕ Nueva cita</a>
            <hr class="nav-divider"/>
        <% } %>

        <!-- Panel de administración: solo si tiene permiso -->
        <% if (tienePermiso('GESTIONAR_USUARIOS')) { %>
            <a href="/usuarios" class="nav-item<%= activePage === 'usuarios' ? ' active' : '' %>">👤 Usuarios</a>
            <a href="/roles"    class="nav-item<%= activePage === 'roles'    ? ' active' : '' %>">🔐 Roles</a>
            <hr class="nav-divider"/>
        <% } %>

        <a href="/catalogo" class="nav-item" style="color: #f50057; font-weight: 600;">🌐 Web Principal</a>
        <a href="/logout" class="nav-item" style="color: #888; margin-top: auto;">🚪 Cerrar sesión</a>
    </nav>

    <!-- ── Contenido principal ──────────────────────────────── -->
    <main class="main">
        <div class="topbar">
            <h1 class="page-title"><%= pageTitle %></h1>
            <div style="display:flex; align-items:center; gap:16px;">
                <a href="/catalogo"
                   style="font-size:12px; color:#f50057; text-decoration:none; font-weight:600;
                          background:#fff1f3; padding:5px 14px; border-radius:50px; border:1px solid #fbb;">
                    🌐 Página Web
                </a>
                <!-- Nombre real del usuario logueado y su rol -->
                <span class="topbar-user">
                    👤 <span><%= usuario ? usuario.nombre : 'Usuario' %></span>
                    <% if (usuario && usuario.rol) { %>
                        <span style="font-size:10px; color:white; padding:2px 8px; border-radius:50px; margin-left:4px;
                                     background:<%= usuario.rol.nombre === 'ADMIN' ? '#f50057' : '#6c757d' %>;">
                            <%= usuario.rol.nombre %>
                        </span>
                    <% } %>
                </span>
                <a href="/logout" style="font-size:12px; color:#888; text-decoration:none;">Salir</a>
            </div>
        </div>
        <div class="content">
            <!-- El contenido de cada página se inserta aquí -->
            <%- body %>
        </div>
    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
