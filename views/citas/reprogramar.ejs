<div class="card form-card">
    <h2 class="form-heading">Reprogramar cita</h2>

    <!-- Aviso con fecha actual -->
    <div style="background:#fff8e1; border-left:4px solid #f9a825; border-radius:4px; padding:12px 16px; margin-bottom:20px;">
        <p style="margin:0 0 4px 0;"><strong>Mascota:</strong>
            <span><%= cita.mascota.nombre %></span>
            (<span><%= cita.mascota.especie %></span>)
            — Dueño: <span><%= cita.mascota.cliente ? cita.mascota.cliente.nombre : '—' %></span>
        </p>
        <p style="margin:0 0 4px 0;"><strong>Fecha actual:</strong>
            <span><%= fmtFecha(cita.fecha) %></span> a las <span><%= fmtHora(cita.hora) %></span>
        </p>
        <% if (cita.vecesReprogramada && cita.vecesReprogramada > 0) { %>
            <p style="margin:0; color:#e65100;">
                ⚠️ Esta cita ya fue reprogramada
                <strong><%= cita.vecesReprogramada %></strong> vez(ces).
                Última razón: <em><%= oGuion(cita.motivoReprogramacion) %></em>
            </p>
        <% } %>
    </div>

    <!-- Error de fecha -->
    <% if (errorFecha) { %>
        <div style="background:#fcebeb; border-left:4px solid #e53e3e; border-radius:6px;
                    padding:10px 16px; margin-bottom:16px; font-size:13px; color:#a32d2d;">
            ⚠️ <span><%= errorFecha %></span>
        </div>
    <% } %>

    <form action="/citas/<%= cita.id %>/reprogramar" method="post">
        <div class="form-grid">
            <div class="form-group">
                <label for="nuevaFecha">Nueva fecha</label>
                <input type="date" id="nuevaFecha" name="nuevaFecha" min="<%= hoy %>" required />
            </div>
            <div class="form-group">
                <label for="nuevaHora">Nueva hora</label>
                <input type="time" id="nuevaHora" name="nuevaHora" required />
            </div>
            <div class="form-group" style="grid-column: span 2;">
                <label for="motivo">Motivo del cambio</label>
                <input type="text" id="motivo" name="motivo"
                    placeholder="Ej: cliente solicitó cambio, emergencia..." />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Confirmar reprogramación</button>
            <a href="/citas" class="btn">Cancelar</a>
        </div>
    </form>
</div>
