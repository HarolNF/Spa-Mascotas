<div class="card form-card" style="max-width: 560px; margin: 40px auto; text-align: center;">
    <div style="font-size: 56px; margin-bottom: 8px;">
        <%= codigo === 403 ? '🔒' : (codigo === 404 ? '🔍' : '⚠️') %>
    </div>
    <h2 class="form-heading" style="margin-bottom: 8px;">Error <%= codigo %></h2>
    <p style="color:#666; font-size: 14px; margin-bottom: 24px;"><%= mensaje %></p>
    <div class="form-actions" style="justify-content: center;">
        <a href="/" class="btn btn-primary">← Volver al panel</a>
        <a href="/catalogo" class="btn">🐾 Ir a la web pública</a>
    </div>
</div>
