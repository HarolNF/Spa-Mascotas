<style>
    .btn-spa { background-color: #f50057; color: white; border: none; border-radius: 50px; }
    .btn-spa:hover { background-color: #d4004b; color: white; }
</style>

<!-- Alertas -->
<% if (exito) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <span><%= exito %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>
<% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <span><%= error %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<!-- Cabecera -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Gestión de Usuarios</h2>
        <p class="text-muted mb-0">Administra los accesos al sistema</p>
    </div>
    <a href="/usuarios/nuevo" class="btn btn-spa">➕ Nuevo Usuario</a>
</div>

<!-- Tabla -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% usuarios.forEach(function (u) { %>
                    <tr>
                        <td class="align-middle fw-semibold"><%= u.nombre %></td>
                        <td class="align-middle text-muted"><%= u.email %></td>
                        <td class="align-middle">
                            <span class="badge rounded-pill" style="background:#f50057; color:white;">
                                <%= u.rol ? u.rol.nombre : 'Sin rol' %>
                            </span>
                        </td>
                        <td class="align-middle text-center">
                            <% if (u.activo) { %>
                                <span class="badge bg-success rounded-pill">Activo</span>
                            <% } else { %>
                                <span class="badge bg-secondary rounded-pill">Inactivo</span>
                            <% } %>
                        </td>
                        <td class="align-middle text-center">
                            <a href="/usuarios/<%= u.id %>/editar"
                               class="btn btn-sm btn-outline-primary me-1">✏️ Editar</a>
                            <form action="/usuarios/<%= u.id %>/toggle" method="post" class="d-inline">
                                <button type="submit"
                                        class="<%= u.activo ? 'btn btn-sm btn-outline-warning' : 'btn btn-sm btn-outline-success' %>">
                                    <%= u.activo ? '🔒 Desactivar' : '✅ Activar' %>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
                <% if (!usuarios.length) { %>
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3 text-end">
    <a href="/roles" class="btn btn-outline-secondary btn-sm">🔐 Gestionar Roles</a>
</div>
