<div class="toolbar">
    <span class="section-title"><%= cliente.id ? 'Editar cliente' : 'Registrar nuevo cliente' %></span>
    <a href="/clientes" class="btn">← Volver a clientes</a>
</div>

<div class="card form-card">

    <!-- Errores de validación -->
    <% if (errores && errores.length) { %>
        <div style="background:#fcebeb; border-left:4px solid #e53e3e; border-radius:6px;
                    padding:12px 16px; margin-bottom:16px; font-size:13px; color:#a32d2d;">
            <% errores.forEach(function (e) { %>
                <div>⚠️ <%= e %></div>
            <% }); %>
        </div>
    <% } %>

    <!-- Aviso informativo solo al crear -->
    <% if (!cliente.id) { %>
        <div style="background:#e8f4fd; border-left:4px solid #3b82f6; border-radius:6px;
                   padding:12px 16px; margin-bottom:20px; font-size:13px; color:#1e40af;">
            💡 Aquí solo registras los datos del <strong>dueño</strong>.
            Una vez guardado, podrás agregar sus mascotas desde el detalle del cliente.
        </div>
    <% } %>

    <form action="<%= cliente.id ? '/clientes/' + cliente.id + '/editar' : '/clientes/nuevo' %>"
          method="post">

        <div class="form-grid">

            <!-- Nombre -->
            <div class="form-group">
                <label for="nombre">Nombre completo *</label>
                <input type="text" id="nombre" name="nombre"
                       value="<%= cliente.nombre || '' %>"
                       placeholder="Ej: Juan Pérez" required />
            </div>

            <!-- Email -->
            <div class="form-group">
                <label for="email">Correo electrónico</label>
                <input type="email" id="email" name="email"
                       value="<%= cliente.email || '' %>"
                       placeholder="Ej: juan@gmail.com" />
            </div>

            <!-- Teléfono -->
            <div class="form-group">
                <label for="telefono">Teléfono *</label>
                <input type="tel" id="telefono" name="telefono"
                       value="<%= cliente.telefono || '' %>"
                       placeholder="Ej: 938 723 104" required />
            </div>

            <!-- Dirección -->
            <div class="form-group">
                <label for="direccion">Dirección</label>
                <input type="text" id="direccion" name="direccion"
                       value="<%= cliente.direccion || '' %>"
                       placeholder="Ej: Jr. Las Flores 123, Lima" />
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <%= cliente.id ? 'Actualizar cliente' : 'Guardar cliente' %>
            </button>
            <a href="/clientes" class="btn">Cancelar</a>
        </div>
    </form>
</div>

<!-- Sección mascotas: SOLO visible al EDITAR (cliente ya existe) -->
<% if (cliente.id) { %>
    <div style="margin-top: 24px;">
        <div class="toolbar">
            <span class="section-title">Mascotas de este cliente</span>
            <!-- Redirige a /mascotas/nueva?clienteId=X para preseleccionar al dueño -->
            <a href="/mascotas/nueva?clienteId=<%= cliente.id %>" class="btn btn-primary">
                + Agregar mascota
            </a>
        </div>

        <div class="card">
            <% if (cliente.mascotas && cliente.mascotas.length) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Especie</th>
                            <th>Raza</th>
                            <th>Tamaño</th>
                            <th>Edad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cliente.mascotas.forEach(function (m) { %>
                            <tr>
                                <td><%= m.nombre %></td>
                                <td><%= m.especie %></td>
                                <td><%= oGuion(m.raza) %></td>
                                <td><%= oGuion(m.tamano) %></td>
                                <td><%= m.edad ? m.edad + ' años' : '—' %></td>
                                <td>
                                    <a href="/mascotas/<%= m.id %>/editar" class="btn btn-sm">Editar</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <div style="padding:20px; text-align:center; color:#888; font-size:13px;">
                    Este cliente aún no tiene mascotas registradas.
                    <br><br>
                    <a href="/mascotas/nueva?clienteId=<%= cliente.id %>" class="btn btn-primary btn-sm">
                        + Registrar primera mascota
                    </a>
                </div>
            <% } %>
        </div>
    </div>
<% } %>
